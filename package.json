{
  "name": "surfelappen",
  "version": "0.1.0",
  "private": true,
  "description": "A small, free, browser-based digital literacy game for Norway.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "check": "biome check --error-on-warnings . && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build && node scripts/check-size.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "11.0.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "harfbuzzjs": "^1.6.3",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "tldts": "^7.4.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
